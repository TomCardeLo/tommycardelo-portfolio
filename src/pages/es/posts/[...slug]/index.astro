---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@/layouts/PostDetails.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft && data.lang === "es");
  return posts.map(post => ({
    // Strip the leading /es/ directory from the path so the URL is /es/posts/hello not /es/posts/es/hello
    params: { slug: getPath(post.id, post.filePath, false).replace(/^\/es\//, "") },
    props: { post },
  }));
}

const { post } = Astro.props;

const posts = await getCollection("blog", ({ data }) => data.lang === "es");
const sortedPosts = getSortedPosts(posts);
---

<PostDetails post={post} posts={sortedPosts} />
