---
import IconHash from "@/assets/icons/IconHash.svg";
import { getLangFromUrl, getLocalePath } from "@/i18n/ui";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const tagsBase = getLocalePath(lang, "/tags/");
---

<li>
  <a
    href={`${tagsBase}${tag}/`}
    transition:name={tag}
    class:list={[
      "flex items-center gap-1 border border-border px-2 py-1 uppercase tracking-wider",
      "hover:bg-foreground hover:text-background",
      "focus-visible:text-accent",
      { "text-xs": size === "sm" },
      { "text-sm": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        { "size-4": size === "lg" },
        { "size-3.5": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
