---
import { getLangFromUrl, getLocalePath } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const { pathname } = Astro.url;

// Strip /es prefix to get the base path, then build the target URL
const basePath = pathname.replace(/^\/es/, "") || "/";

// All pages (including post details) have translations, so link directly.
const enHref = basePath;
const esHref = getLocalePath("es", basePath);
---

<div class="flex items-center gap-1 t-label">
  {
    lang === "en" ? (
      <>
        <span aria-current="true">
          <span aria-hidden="true">[</span>EN<span aria-hidden="true">]</span>
        </span>
        <span class="text-muted-fg">/</span>
        <a href={esHref} class="text-muted-fg hover:text-accent">
          ES
        </a>
      </>
    ) : (
      <>
        <a href={enHref} class="text-muted-fg hover:text-accent">
          EN
        </a>
        <span class="text-muted-fg">/</span>
        <span aria-current="true">
          <span aria-hidden="true">[</span>ES<span aria-hidden="true">]</span>
        </span>
      </>
    )
  }
</div>
