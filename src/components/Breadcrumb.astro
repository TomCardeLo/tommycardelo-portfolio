---
import { getLangFromUrl, useTranslations } from "@/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === "es" ? "/es/" : "/";

// Remove trailing slash, then split into non-empty segments
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
let segments = currentUrlPath.split("/").filter(Boolean);

// Remove 'es' prefix — it's the locale, not a real breadcrumb segment
if (segments[0] === "es") {
  segments = segments.slice(1);
}

// Collapse Posts pagination: /posts/2 → "Posts (page 2)"
if (segments[0] === "posts" && segments.length > 1) {
  segments.splice(0, 2, `Posts (page ${segments[1] || 1})`);
}

// Collapse Tags pagination: /tags/tagname/2 → "tagname (page 2)"
if (segments[0] === "tags" && !isNaN(Number(segments[2]))) {
  segments.splice(
    1,
    3,
    `${segments[1]} ${Number(segments[2]) === 1 ? "" : "(page " + segments[2] + ")"}`
  );
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={homeHref} class="opacity-80">{t("breadcrumb.home")}</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      segments.map((breadcrumb, index) =>
        index + 1 === segments.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a href={`${homeHref}${breadcrumb}/`} class="capitalize opacity-70">
              {breadcrumb}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
